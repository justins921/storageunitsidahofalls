# Copy this file to .env.local for local development, and set the same values
# in your Vercel project settings (Settings -> Environment Variables) for
# production. Every variable is OPTIONAL — with none set, no tracking scripts
# load and the site behaves exactly as before.
#
# After adding or changing any of these in Vercel, redeploy for them to apply.

# --- Which city this deployment serves ---
# Selects the config in lib/sites/. Unset (or "idaho-falls") = Idaho Falls;
# "rexburg" = Rexburg. Set this per Vercel project so one repo powers both sites.
NEXT_PUBLIC_SITE=

# --- Google Analytics 4 (measurement) ---
# GA4 -> Admin -> Data Streams -> your web stream -> "Measurement ID"
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Ads (conversion tracking) ---
# Google Ads -> Tools -> Conversions. The tag ID looks like AW-XXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Phone-call conversion "send_to" value: the Google Ads tag ID, a slash, and
# the conversion label, e.g. AW-XXXXXXXXX/AbCdEfGhIjKl. Create a "Phone calls
# from a website" (or "Contact") conversion action to get the label. Every
# tel: click on the site fires this conversion automatically.
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION=

# --- Meta (Facebook/Instagram) Pixel ---
# Meta Events Manager -> Data Sources -> your pixel -> the numeric Pixel ID.
# Page views fire automatically; tel: clicks fire a "Contact" event.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Search Console (site verification) ---
# Only needed if you verify via the HTML-tag method. Search Console -> add
# property -> "HTML tag" -> copy the content="..." token here. (DNS
# verification is an alternative that doesn't need this.)
GOOGLE_SITE_VERIFICATION=
